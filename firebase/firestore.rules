rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Operator and Administrator applications write through the trusted Flask
    // backend (Firebase Admin SDK). Standalone Traveller reads use only the
    // server-authored public projections below. Mixed source documents remain
    // backend-only; Firestore rules cannot hide individual fields.

    match /tourism_packages/{packageId} {
      allow read, write: if false;
    }

    match /public_tourism_packages/{packageId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /promotional_campaigns/{campaignId} {
      allow read, write: if false;
    }

    match /public_promotional_campaigns/{campaignId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /feedback/{feedbackId} {
      // A Traveller can read/query only their own source records for edit and
      // delete flows. Public review display uses the projection collection.
      allow read: if signedIn()
                  && resource.data.travellerId == request.auth.uid;

      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly([
                      'destinationId',
                      'destinationName',
                      'destinationAddress',
                      'rating',
                      'comment',
                      'travellerId',
                      'travellerName',
                      'feedbackStatus',
                      'moderationStatus',
                      'submittedAt',
                      'updatedAt'
                    ])
                    && request.resource.data.keys().hasAll([
                      'destinationId',
                      'rating',
                      'travellerId',
                      'feedbackStatus',
                      'moderationStatus',
                      'submittedAt',
                      'updatedAt'
                    ])
                    && request.resource.data.travellerId == request.auth.uid
                    && request.resource.data.feedbackStatus == 'visible'
                    && request.resource.data.moderationStatus == 'pending_review'
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;

      allow update: if signedIn()
                    && resource.data.travellerId == request.auth.uid
                    && resource.data.feedbackStatus == 'visible'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'rating',
                      'comment',
                      'feedbackStatus',
                      'moderationStatus',
                      'updatedAt'
                    ])
                    && request.resource.data.travellerId == request.auth.uid
                    && request.resource.data.feedbackStatus == 'visible'
                    && request.resource.data.moderationStatus == 'pending_review'
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;

      allow delete: if signedIn()
                    && resource.data.travellerId == request.auth.uid;
    }

    match /public_destination_reviews/{reviewId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // All other application business data remains backend-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
