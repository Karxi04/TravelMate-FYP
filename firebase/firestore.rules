rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Operator and Administrator applications write through the trusted Flask
    // backend (Firebase Admin SDK). Traveller receives only approved shared
    // content directly from Firestore so the installed app does not require a
    // USB connection or a locally running Flask server.

    match /tourism_packages/{packageId} {
      allow read: if signedIn()
                  && resource.data.approvalStatus == 'approved';
      allow write: if false;
    }

    match /promotional_campaigns/{campaignId} {
      allow read: if signedIn()
                  && resource.data.reviewStatus == 'approved';
      allow write: if false;
    }

    match /feedback/{feedbackId} {
      // Visible Traveller reviews can be displayed on destination details.
      // A Traveller can always read their own record even if an Administrator
      // has removed it from the public review list.
      allow read: if signedIn()
                  && (resource.data.feedbackStatus == 'visible'
                      || resource.data.travellerId == request.auth.uid);

      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly([
                      'destinationId',
                      'destinationName',
                      'destinationAddress',
                      'rating',
                      'comment',
                      'travellerId',
                      'travellerName',
                      'feedbackStatus',
                      'moderationStatus',
                      'submittedAt',
                      'updatedAt'
                    ])
                    && request.resource.data.keys().hasAll([
                      'destinationId',
                      'rating',
                      'travellerId',
                      'feedbackStatus',
                      'moderationStatus',
                      'submittedAt',
                      'updatedAt'
                    ])
                    && request.resource.data.travellerId == request.auth.uid
                    && request.resource.data.feedbackStatus == 'visible'
                    && request.resource.data.moderationStatus == 'pending_review'
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;

      allow update: if signedIn()
                    && resource.data.travellerId == request.auth.uid
                    && resource.data.feedbackStatus == 'visible'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'rating',
                      'comment',
                      'feedbackStatus',
                      'moderationStatus',
                      'updatedAt'
                    ])
                    && request.resource.data.travellerId == request.auth.uid
                    && request.resource.data.feedbackStatus == 'visible'
                    && request.resource.data.moderationStatus == 'pending_review'
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;

      allow delete: if signedIn()
                    && resource.data.travellerId == request.auth.uid;
    }

    // All other application business data remains backend-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
