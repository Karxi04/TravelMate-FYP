# Cloud Run runtime configuration. Replace every placeholder in Secret Manager; never commit real values.
APP_ENV=production
FLASK_DEBUG=false
FALLBACK_MODE=false
CORS_ALLOWED_ORIGINS=https://OPERATOR_PORTAL_URL,https://ADMIN_PORTAL_URL
GEMINI_MODEL=gemini-3.7-flash
STRIPE_CHECKOUT_SUCCESS_URL=https://API_URL/api/fr9/checkout/return/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=https://API_URL/api/fr9/checkout/return/cancel?session_id={CHECKOUT_SESSION_ID}
PAYMENT_SIMULATION_MODE=false
# Configure these only through Cloud Run --update-secrets mappings:
# FIREBASE_SERVICE_ACCOUNT_JSON=travelmate-firebase-admin:latest (omit when using service-account ADC)
# SERPAPI_KEY=travelmate-serpapi:latest
# LITEAPI_KEY=travelmate-liteapi:latest
# STRIPE_SECRET_KEY=travelmate-stripe-test:latest
# STRIPE_WEBHOOK_SECRET=travelmate-stripe-webhook:latest
# GEMINI_API_KEY=travelmate-gemini:latest
