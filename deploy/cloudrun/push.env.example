# Activate only after confirming the normal Android app, matching Firebase sender and worker IAM.
TRAVELMATE_PUSH_ENABLED=false
# Set false while validating the authorized device registration and Firebase sender.
PUSH_DISPATCH_ENABLED=false
PUSH_FIREBASE_PROJECT_ID=travelmate2-30a8a
PUSH_ANDROID_APP_IDS=com.example.travelmate_traveller
# Set the authorized acceptance account UID on both the API and the worker for a one-account rollout.
PUSH_TRAVELLER_UID=
# Use Cloud Run service identity / ADC. Never put service-account keys in the mobile app.
