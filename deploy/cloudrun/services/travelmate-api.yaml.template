apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: travelmate-api
  annotations:
    run.googleapis.com/ingress: all
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/minScale: "0"
        autoscaling.knative.dev/maxScale: "2"
    spec:
      containerConcurrency: 20
      timeoutSeconds: 120
      serviceAccountName: travelmate-api@PROJECT_ID.iam.gserviceaccount.com
      containers:
        - image: IMAGE_URI
          ports:
            - containerPort: 8080
          startupProbe:
            httpGet:
              path: /api/health
              port: 8080
            periodSeconds: 10
            timeoutSeconds: 2
            failureThreshold: 12
