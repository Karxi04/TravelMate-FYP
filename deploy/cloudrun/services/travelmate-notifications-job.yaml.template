apiVersion: run.googleapis.com/v1
kind: Job
metadata:
  name: travelmate-notifications
spec:
  template:
    spec:
      taskCount: 1
      parallelism: 1
      template:
        spec:
          serviceAccountName: travelmate-notifications@PROJECT_ID.iam.gserviceaccount.com
          timeoutSeconds: "900"
          maxRetries: 1
          containers:
            - image: IMAGE_URI
              command: ["python"]
              args: ["-B", "scripts/notification_worker.py"]
              resources:
                limits:
                  cpu: "1"
                  memory: 512Mi
              env:
                - name: TRAVELMATE_PUSH_ENABLED
                  value: "true"
                - name: PUSH_FIREBASE_PROJECT_ID
                  value: PROJECT_ID
                - name: PUSH_ANDROID_APP_IDS
                  value: org.travelmate.hermetic.travelmate_hermetic
