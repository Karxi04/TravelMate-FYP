PORT=5000
FLASK_DEBUG=false
LOCAL_LAN_DEMO=false
# Required only when LOCAL_LAN_DEMO=true; example: 192.168.1.0/24
TRUSTED_LAN_CIDR=

# Comma-separated explicit browser origins. Native Flutter does not use CORS.
# Example: http://127.0.0.1:5001,http://127.0.0.1:5002
CORS_ALLOWED_ORIGINS=

# Firebase Admin SDK service account JSON path
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json

# When true, destination/flight/hotel endpoints can return local sample data
# if provider keys are not configured. Set false for final live-provider testing.
FALLBACK_MODE=true

# SerpApi: Google Maps + Google Flights
SERPAPI_KEY=

# LiteAPI / Nuitee sandbox hotel API key
LITEAPI_KEY=

# Stripe sandbox/test secret key only (starts with sk_test_ in test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required for LOCAL_LAN_DEMO, for example http://192.168.1.20:5000.
# Production must use the deployed backend's HTTPS origin.
STRIPE_CHECKOUT_RETURN_ORIGIN=
# Backwards-compatible desktop/cloud full-URL configuration when no origin is set.
STRIPE_CHECKOUT_SUCCESS_URL=http://127.0.0.1:5000/api/fr9/checkout/return/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://127.0.0.1:5000/api/fr9/checkout/return/cancel?session_id={CHECKOUT_SESSION_ID}
# Payment simulation is opt-in and independent from other provider fallbacks.
PAYMENT_SIMULATION_MODE=false

# Shared Firestore fixed-window budgets. Keep the Firestore TTL policy enabled
# for rate_limit_windows.expiresAt in cloud deployment.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_RETENTION_SECONDS=86400
RATE_LIMIT_AUTHENTICATION_PER_WINDOW=10
RATE_LIMIT_CHAT_PER_WINDOW=12
RATE_LIMIT_RECOMMENDATION_PER_WINDOW=6
RATE_LIMIT_PROVIDER_SEARCH_PER_WINDOW=30
RATE_LIMIT_PAYMENT_MUTATION_PER_WINDOW=10
RATE_LIMIT_HOTEL_MUTATION_PER_WINDOW=10

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
