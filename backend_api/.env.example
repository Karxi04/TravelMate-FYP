PORT=5000

# Firebase Admin SDK service account JSON path
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json

# When true, destination/flight/hotel endpoints can return local sample data
# if provider keys are not configured. Set false for final live-provider testing.
FALLBACK_MODE=true

# SerpApi: Google Maps + Google Flights
SERPAPI_KEY=

# LiteAPI / Nuitee sandbox hotel API key
LITEAPI_KEY=

# Stripe sandbox/test secret key only (starts with sk_test_ in test mode)
STRIPE_SECRET_KEY=

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
