PORT=5000
FLASK_DEBUG=false

# Comma-separated explicit browser origins. Native Flutter does not use CORS.
# Example: http://127.0.0.1:5001,http://127.0.0.1:5002
CORS_ALLOWED_ORIGINS=

# Firebase Admin SDK service account JSON path
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json

# When true, destination/flight/hotel endpoints can return local sample data
# if provider keys are not configured. Set false for final live-provider testing.
FALLBACK_MODE=true

# SerpApi: Google Maps + Google Flights
SERPAPI_KEY=

# LiteAPI / Nuitee sandbox hotel API key
LITEAPI_KEY=

# Stripe sandbox/test secret key only (starts with sk_test_ in test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local desktop defaults; use a reachable LAN host for a physical phone.
STRIPE_CHECKOUT_SUCCESS_URL=http://127.0.0.1:5000/api/fr9/checkout/return/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://127.0.0.1:5000/api/fr9/checkout/return/cancel?session_id={CHECKOUT_SESSION_ID}
# Payment simulation is opt-in and independent from other provider fallbacks.
PAYMENT_SIMULATION_MODE=false

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
